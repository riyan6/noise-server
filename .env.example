# These are environment variables; the program does not load .env files automatically.
# Required only when creating the first administrator. Set your own 12–72 byte password.
NOISE_ADMIN_USERNAME=admin
NOISE_ADMIN_PASSWORD=

NOISE_ADDR=127.0.0.1:8080
NOISE_DB=data/noise.db
NOISE_API_URL=https://api.example.com
NOISE_DASHBOARD_URL=https://status.example.com
NOISE_ADMIN_ORIGINS=https://admin.example.com
NOISE_PUBLIC_ORIGINS=https://status.example.com
NOISE_COOKIE_SECURE=true
NOISE_TIMEZONE=Asia/Shanghai
# Set only when a trusted reverse proxy forwards requests to this service.
NOISE_TRUSTED_PROXIES=127.0.0.1,::1
